# ------------------------------------------------------------------
# RevealLink frontend — environment
# Copy this file to `.env.local` and fill in the values.
# Every variable below is read at build/runtime on the Next.js server
# unless it is prefixed with NEXT_PUBLIC_ (exposed to the browser).
# ------------------------------------------------------------------

# Base URL of the RevealLink backend API (Express + Mongoose).
# Used exclusively on the server by the BFF proxy and server actions.
API_URL=http://localhost:5000

# Public origin of this Next.js app. Used by Auth.js for callback URLs
# and to decide whether the session cookie is marked Secure.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used by Auth.js to sign/encrypt the session JWT.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Optional. When set, Auth.js uses it instead of AUTH_SECRET.
# AUTH_SECRET is normally sufficient — leave this unset unless you
# are migrating between Auth.js versions.
# AUTH_SECRET_KEY=

# The Auth.js `baseUrl`/`issuer`. Defaults to NEXT_PUBLIC_APP_URL.
# AUTH_URL=http://localhost:3000

# --- Google Sign-In (optional) -------------------------------------
# Both values come from Google Cloud Console → APIs & Services →
# Credentials → OAuth 2.0 Client ID (type: Web application).
# The browser obtains an ID token via Google Identity Services and
# posts it to the backend `/auth/signup-with-gmail` endpoint.
# If either value is missing the "Continue with Google" button is hidden.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# --- Optional UX tuning --------------------------------------------
# Milliseconds the client waits before assuming a request timed out.
# NEXT_PUBLIC_REQUEST_TIMEOUT=20000
